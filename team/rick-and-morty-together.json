{
  "id": "rick-and-morty-together",
  "repo": "multiplayereverything/rick-and-morty-coop",
  "minLauncher": "1.0.42",
  "approved_at": "2026-11-04",
  "approved_by": "Multiplayer Everything Team",
  "name": "Rick and Morty Together",
  "site": "rickandmorty",
  "players": "2 players (co-op)",
  "categories": [
    "pc",
    "coop"
  ],
  "guide": {
    "needs": [
      "Your own copy of Rick and Morty: Virtual Rick-ality on Steam, and a VR headset.",
      "Everyone you play with needs the same version of the mod. The launcher keeps yours up to date."
    ],
    "steps": [
      "Press Install. The launcher finds your copy of the game and puts the mod, the BepInEx loader it needs and the mod's own BepInEx settings in it.",
      "Press Launch.",
      "On the desktop window (the mirror of your headset view) press F5 to open the panel. Set it up before you put the headset on, or ask someone at the PC.",
      "Host on Steam opens a lobby (friends only by default, or public); invite Steam friends, or they pick Join Game on you in Steam.",
      "No Steam? Host on LAN / direct IP listens on TCP port 27040; friends type your IP and press Join IP."
    ],
    "keys": [
      {
        "key": "F5",
        "does": "Opens the multiplayer panel on the desktop window."
      }
    ],
    "tips": [
      "Two players: a third is refused with a message.",
      "The mod's BepInEx settings are part of the install: this game needs BepInEx to start at the first scene load.",
      "Things the game spawns (machine results, dispensers) are not shared yet."
    ],
    "links": [
      {
        "label": "Rick and Morty Together on GitHub",
        "url": "https://github.com/multiplayereverything/rick-and-morty-coop"
      },
      {
        "label": "Multiplayer Everything Discord",
        "url": "https://discord.com/invite/P2MSSUf5GX"
      }
    ]
  },
  "color": "#7BD16B",
  "colorEnd": "#0F3A1E",
  "description": "Co-op for Rick and Morty: Virtual Rick-ality (Steam, VR): two players share one game as Morty clones in the same garage, see each other's head and hands, and pass things from hand to hand, with the story and the lines in sync. Everyone needs the same version.",
  "mod": {
    "id": "rick-and-morty-together",
    "game": {
      "name": "Rick and Morty: Virtual Rick-ality",
      "executable": "RickAndMortyVR.exe",
      "steamAppId": "469610",
      "validationFiles": [
        "${GAME_EXE}",
        "RickAndMortyVR_Data"
      ],
      "processNames": [
        "RickAndMortyVR.exe"
      ],
      "detection": [
        {
          "type": "path",
          "path": "${folder:ProgramFilesX86}\\Steam\\steamapps\\common\\RickAndMortyVR"
        },
        {
          "type": "steam",
          "appId": "469610",
          "installDir": "RickAndMortyVR"
        }
      ]
    },
    "install": {
      "targetDir": "${GAME_DIR}\\BepInEx\\plugins\\RickAndMortyTogether",
      "stateDir": "${INSTALL_DIR}\\.installer",
      "uninstallCleanupWith": "loader",
      "uninstallCleanup": [
        "BepInEx/cache/**",
        "BepInEx/patchers/**",
        "BepInEx/LogOutput.log",
        "BepInEx/ErrorLog.log"
      ]
    },
    "components": [
      {
        "id": "loader",
        "name": "BepInEx mod loader",
        "source": "loader/BepInEx/core",
        "target": "${GAME_DIR}\\BepInEx\\core",
        "skipIfPresent": [
          "BepInEx/core"
        ],
        "required": true
      },
      {
        "id": "loader-winhttp",
        "name": "BepInEx mod loader",
        "source": "loader/winhttp.dll",
        "target": "${GAME_DIR}",
        "skipIfPresent": [
          "BepInEx/core"
        ],
        "required": true
      },
      {
        "id": "loader-doorstop",
        "name": "BepInEx mod loader",
        "source": "loader/doorstop_config.ini",
        "target": "${GAME_DIR}",
        "skipIfPresent": [
          "BepInEx/core"
        ],
        "required": true
      },
      {
        "id": "loader-version",
        "name": "BepInEx mod loader",
        "source": "loader/.doorstop_version",
        "target": "${GAME_DIR}",
        "skipIfPresent": [
          "BepInEx/core"
        ],
        "required": true
      },
      {
        "id": "config",
        "name": "BepInEx settings for this game",
        "source": "BepInEx/config/BepInEx.cfg",
        "target": "${GAME_DIR}\\BepInEx\\config",
        "required": true
      },
      {
        "id": "mod",
        "name": "Rick and Morty Together",
        "source": "BepInEx/plugins/RickAndMortyTogether",
        "required": true
      }
    ],
    "launch": {
      "uri": "steam://rungameid/${STEAM_APP_ID}",
      "hint": "Press F5 on the desktop window to open the panel, then host or join."
    },
    "package": {
      "github": "multiplayereverything/rick-and-morty-coop",
      "asset": "RickAndMortyTogether-BepInEx-*.zip",
      "extras": [
        {
          "dir": "loader",
          "github": "multiplayereverything/rick-and-morty-coop",
          "tag": "bepinex-5.4.23.5",
          "asset": "BepInEx_win_x64_5.4.23.5.zip"
        }
      ]
    }
  }
}
