{
  "id": "miside-together",
  "repo": "multiplayereverything/miside-coop",
  "platform": "pc",
  "author": "Multiplayer Everything",
  "minLauncher": "1.0.42",
  "approved_at": "2026-11-04",
  "approved_by": "Multiplayer Everything Team",
  "name": "MiSide Together",
  "site": "miside",
  "players": "2-4 players (co-op)",
  "categories": [
    "pc",
    "coop"
  ],
  "guide": {
    "needs": [
      "Your own copy of MiSide on Steam.",
      "Everyone you play with needs the same version of the mod. The launcher keeps yours up to date."
    ],
    "steps": [
      "Press Install. The launcher finds your copy of MiSide and puts the mod, and BepInEx 6 which it needs, in it.",
      "Press Launch. The first start after installing takes about a minute.",
      "In the main menu open MULTIPLAYER, a new entry above Exit.",
      "The host picks HOST GAME. Steam friends and players on your network can then join.",
      "Friends pick JOIN <name> (STEAM) for each Steam friend hosting, JOIN <name> (LAN) for a game on your network or VPN, or JOIN BY ADDRESS to type one (TCP port 27030).",
      "The host plays the story as usual (New game, Continue or Chapters). Everyone else follows automatically."
    ],
    "keys": [
      {
        "key": "F5",
        "does": "Join by address: opens the panel to type the host's address."
      }
    ],
    "tips": [
      "Up to four players.",
      "A friend who connects in the middle of a chapter waits in the menu and comes along when the next chapter starts.",
      "If the host leaves, the next player becomes the host and the others reconnect to them."
    ],
    "links": [
      {
        "label": "Multiplayer Everything Discord",
        "url": "https://discord.com/invite/P2MSSUf5GX"
      }
    ]
  },
  "color": "#E58AB0",
  "colorEnd": "#3A1226",
  "description": "Co-op for MiSide (Steam): two to four players play the story together, with Mita, the cutscenes and the dialogue in sync. Friends join through Steam, your network or an address. Everyone needs the same version.",
  "mod": {
    "id": "miside-together",
    "game": {
      "name": "MiSide",
      "executable": "MiSideFull.exe",
      "steamAppId": "2527500",
      "validationFiles": [
        "${GAME_EXE}",
        "MiSideFull_Data",
        "GameAssembly.dll"
      ],
      "processNames": [
        "MiSideFull.exe"
      ],
      "detection": [
        {
          "type": "path",
          "path": "${folder:ProgramFilesX86}\\Steam\\steamapps\\common\\MiSide"
        },
        {
          "type": "steam",
          "appId": "2527500",
          "installDir": "MiSide"
        }
      ]
    },
    "install": {
      "targetDir": "${GAME_DIR}\\BepInEx\\plugins\\MiSideTogether",
      "stateDir": "${INSTALL_DIR}\\.installer",
      "uninstallCleanupWith": "loader",
      "uninstallCleanup": [
        "BepInEx/cache/**",
        "BepInEx/interop/**",
        "BepInEx/unity-libs/**",
        "BepInEx/patchers/**",
        "BepInEx/config/BepInEx.cfg",
        "BepInEx/LogOutput.log",
        "BepInEx/ErrorLog.log"
      ]
    },
    "components": [
      {
        "id": "loader",
        "name": "BepInEx 6 mod loader",
        "source": "loader/BepInEx",
        "target": "${GAME_DIR}\\BepInEx",
        "skipIfPresent": [
          "BepInEx/core/BepInEx.Unity.IL2CPP.dll"
        ],
        "required": true
      },
      {
        "id": "loader-dotnet",
        "name": "BepInEx 6 mod loader",
        "source": "loader/dotnet",
        "target": "${GAME_DIR}\\dotnet",
        "skipIfPresent": [
          "BepInEx/core/BepInEx.Unity.IL2CPP.dll"
        ],
        "required": true
      },
      {
        "id": "loader-winhttp",
        "name": "BepInEx 6 mod loader",
        "source": "loader/winhttp.dll",
        "target": "${GAME_DIR}",
        "skipIfPresent": [
          "BepInEx/core/BepInEx.Unity.IL2CPP.dll"
        ],
        "required": true
      },
      {
        "id": "loader-doorstop",
        "name": "BepInEx 6 mod loader",
        "source": "loader/doorstop_config.ini",
        "target": "${GAME_DIR}",
        "skipIfPresent": [
          "BepInEx/core/BepInEx.Unity.IL2CPP.dll"
        ],
        "required": true
      },
      {
        "id": "loader-version",
        "name": "BepInEx 6 mod loader",
        "source": "loader/.doorstop_version",
        "target": "${GAME_DIR}",
        "skipIfPresent": [
          "BepInEx/core/BepInEx.Unity.IL2CPP.dll"
        ],
        "required": true
      },
      {
        "id": "mod",
        "name": "MiSide Together",
        "source": "BepInEx/plugins/MiSideTogether",
        "required": true
      }
    ],
    "launch": {
      "uri": "steam://rungameid/${STEAM_APP_ID}",
      "hint": "In the main menu open MULTIPLAYER: host a game, or join a Steam friend or a LAN game."
    },
    "package": {
      "github": "multiplayereverything/miside-coop",
      "asset": "MiSideTogether-*.zip",
      "extras": [
        {
          "dir": "loader",
          "github": "multiplayereverything/miside-coop",
          "tag": "bepinex-6.0.0-be.790",
          "asset": "BepInEx-Unity.IL2CPP-win-x64-6.0.0-be.790.zip"
        }
      ]
    }
  }
}
