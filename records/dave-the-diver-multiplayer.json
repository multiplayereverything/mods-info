{
  "id": "dave-the-diver-multiplayer",
  "repo": "multiplayereverything/Dave-The-Divers-Coop",
  "platform": "pc",
  "author": "Multiplayer Everything",
  "minLauncher": "1.0.42",
  "approved_at": "2026-11-04",
  "approved_by": "Multiplayer Everything Team",
  "name": "Dave the Diver Multiplayer",
  "site": "davethediver",
  "players": "2 players (co-op)",
  "categories": [
    "pc",
    "coop"
  ],
  "guide": {
    "needs": [
      "Your own copy of Dave the Diver on Steam.",
      "Everyone you play with needs the same game build and the same version of the mod. The launcher keeps yours up to date."
    ],
    "steps": [
      "Press Install. The launcher finds your copy of the game and puts the mod, and BepInEx 6 which it needs, in it.",
      "Press Launch. The first start after installing takes a minute or two.",
      "On the title screen pick Online.",
      "Host on Steam opens a friends-only lobby; friends see Join game on your Steam profile, or press Invite a friend.",
      "No Steam? Create lobby (LAN) and give your friend your IP; they pick Join by IP (LAN) (UDP port 27777).",
      "When your friend is connected they press Ready, and the host presses Start. The host's campaign is copied to the friend, and you continue it together."
    ],
    "keys": [],
    "tips": [
      "Your normal saves are never touched: the shared campaign uses manual save slot 7.",
      "Two players: one friend per host."
    ],
    "links": [
      {
        "label": "Dave the Diver Multiplayer on GitHub",
        "url": "https://github.com/multiplayereverything/Dave-The-Divers-Coop"
      },
      {
        "label": "Original Coop-Divers by S1ii",
        "url": "https://github.com/S1ii/Coop-Divers"
      },
      {
        "label": "Multiplayer Everything Discord",
        "url": "https://discord.com/invite/P2MSSUf5GX"
      }
    ]
  },
  "color": "#2BA7C9",
  "colorEnd": "#06303D",
  "description": "Two-player online co-op for Dave the Diver: dive the Blue Hole together, see each other, and share the fish, the story and the sushi bar. Join a friend through Steam or LAN. Originally made by S1ii; this fork is maintained by Multiplayer Everything. Unofficial community mod. Everyone needs the same version.",
  "mod": {
    "id": "dave-the-diver-multiplayer",
    "game": {
      "name": "DAVE THE DIVER",
      "executable": "DaveTheDiver.exe",
      "steamAppId": "1868140",
      "validationFiles": [
        "${GAME_EXE}",
        "DaveTheDiver_Data",
        "GameAssembly.dll"
      ],
      "processNames": [
        "DaveTheDiver.exe"
      ],
      "detection": [
        {
          "type": "path",
          "path": "${folder:ProgramFilesX86}\\Steam\\steamapps\\common\\DAVE THE DIVER"
        },
        {
          "type": "steam",
          "appId": "1868140",
          "installDir": "DAVE THE DIVER"
        }
      ]
    },
    "install": {
      "targetDir": "${GAME_DIR}\\BepInEx\\plugins\\DaveTheDiverMP",
      "stateDir": "${INSTALL_DIR}\\.installer",
      "uninstallCleanupWith": "loader",
      "uninstallCleanup": [
        "BepInEx/cache/**",
        "BepInEx/interop/**",
        "BepInEx/unity-libs/**",
        "BepInEx/patchers/**",
        "BepInEx/config/BepInEx.cfg",
        "BepInEx/LogOutput.log",
        "BepInEx/ErrorLog.log"
      ]
    },
    "components": [
      {
        "id": "loader",
        "name": "BepInEx 6 mod loader",
        "source": "loader/BepInEx",
        "target": "${GAME_DIR}\\BepInEx",
        "skipIfPresent": [
          "BepInEx/core/BepInEx.Unity.IL2CPP.dll"
        ],
        "required": true
      },
      {
        "id": "loader-dotnet",
        "name": "BepInEx 6 mod loader",
        "source": "loader/dotnet",
        "target": "${GAME_DIR}\\dotnet",
        "skipIfPresent": [
          "BepInEx/core/BepInEx.Unity.IL2CPP.dll"
        ],
        "required": true
      },
      {
        "id": "loader-winhttp",
        "name": "BepInEx 6 mod loader",
        "source": "loader/winhttp.dll",
        "target": "${GAME_DIR}",
        "skipIfPresent": [
          "BepInEx/core/BepInEx.Unity.IL2CPP.dll"
        ],
        "required": true
      },
      {
        "id": "loader-doorstop",
        "name": "BepInEx 6 mod loader",
        "source": "loader/doorstop_config.ini",
        "target": "${GAME_DIR}",
        "skipIfPresent": [
          "BepInEx/core/BepInEx.Unity.IL2CPP.dll"
        ],
        "required": true
      },
      {
        "id": "loader-version",
        "name": "BepInEx 6 mod loader",
        "source": "loader/.doorstop_version",
        "target": "${GAME_DIR}",
        "skipIfPresent": [
          "BepInEx/core/BepInEx.Unity.IL2CPP.dll"
        ],
        "required": true
      },
      {
        "id": "mod",
        "name": "Dave the Diver Multiplayer",
        "source": "BepInEx/plugins/DaveTheDiverMP",
        "required": true
      }
    ],
    "launch": {
      "uri": "steam://rungameid/${STEAM_APP_ID}",
      "hint": "On the title screen pick Online: host on Steam or LAN, or join a friend."
    },
    "package": {
      "github": "multiplayereverything/Dave-The-Divers-Coop",
      "asset": "DaveTheDiverMP-*.zip",
      "extras": [
        {
          "dir": "loader",
          "github": "multiplayereverything/Dave-The-Divers-Coop",
          "tag": "bepinex-6.0.0-be.790",
          "asset": "BepInEx-Unity.IL2CPP-win-x64-6.0.0-be.790.zip"
        }
      ]
    }
  }
}
